+		t.Fatalf("interrupted stdout must not become a successful response: output=%q error=%v", output, err)
+	}
+	// The real CLI exits 130 without a cancelled end event. The host must use
+	// its cancellation context/exit status; stdout alone cannot prove why it ended.
+	if errors.Is(err, context.Canceled) {
+		t.Fatalf("incomplete stdout alone must not invent a cancellation cause: %v", err)
+	}
+}
+
+func TestNormalizeGrokProtocolEdges(t *testing.T) {
+	tests := []struct {
+		name, raw, want string
+		failed          bool
+		canceled        bool
+	}{
+		{name: "structured output wins", raw: `{"text":"stale","structuredOutput":{"answer":42},"stopReason":"end_turn"}`, want: `{"answer":42}`},
+		{name: "null structure uses text", raw: `{"text":"answer","structuredOutput":null,"stopReason":"end_turn"}`, want: "answer"},
+		{name: "terminal snapshot is used once", raw: "{\"type\":\"text\",\"data\":\"answer\"}\n{\"type\":\"end\",\"text\":\"answer\",\"stopReason\":\"end_turn\"}", want: "answer"},
+		{name: "repeated deltas preserved", raw: "{\"type\":\"text\",\"data\":\"ha\"}\n{\"type\":\"text\",\"data\":\"ha\"}\n{\"type\":\"end\",\"stopReason\":\"end_turn\"}", want: "haha"},
+		{name: "cancelled terminal", raw: `{"type":"end","stopReason":"cancelled"}`, failed: true, canceled: true},
+		{name: "cancelled error", raw: `{"type":"error","message":"Request cancelled","stopReason":"cancelled"}`, failed: true, canceled: true},
+		{name: "truncation", raw: `{"text":"partial","stopReason":"max_tokens"}`, failed: true},
+		{name: "turn limit", raw: `{"text":"partial","stopReason":"max_turn_requests"}`, failed: true},
+		{name: "refusal", raw: `{"text":"refused","stopReason":"refusal"}`, failed: true},
+		{name: "unknown terminal", raw: `{"text":"answer","stopReason":"success"}`, failed: true},
+		{name: "missing terminal reason", raw: `{"text":"answer"}`, failed: true},
+		{name: "empty success", raw: `{"stopReason":"end_turn"}`, failed: true},
+		{name: "partial text without end", raw: `{"type":"text","data":"partial"}`, failed: true},
+		{name: "wrong messages protocol", raw: `{"type":"result","subtype":"success","is_error":false,"result":"answer"}`, failed: true},
+		{name: "malformed event", raw: "{\"type\":\"text\",\"data\":\"partial\"}\nnot-json", failed: true},
+		{name: "event after end", raw: "{\"type\":\"end\",\"text\":\"answer\",\"stopReason\":\"end_turn\"}\n{\"type\":\"text\",\"data\":\"late\"}", failed: true},
+		{name: "error after text", raw: "{\"type\":\"text\",\"data\":\"partial\"}\n{\"type\":\"error\",\"message\":\"backend failed\"}", failed: true},
+		{name: "missing delta data", raw: "{\"type\":\"text\"}\n{\"type\":\"end\",\"stopReason\":\"end_turn\"}", failed: true},
+		{name: "unknown event tolerated", raw: "{\"type\":\"future_metadata\",\"data\":\"ignored\"}\n{\"type\":\"end\",\"text\":\"answer\",\"stopReason\":\"end_turn\"}", want: "answer"},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			output, err := normalizeGrokCLIOutput(test.raw)
+			if (err != nil) != test.failed || output != test.want {
+				t.Fatalf("output=%q error=%v; want=%q failed=%v", output, err, test.want, test.failed)
+			}
+			if errors.Is(err, context.Canceled) != test.canceled {
+				t.Fatalf("cancellation classification=%v; want=%v", err, test.canceled)
+			}
+		})
+	}
+}
diff --git a/runtime/cli/progress.go b/runtime/cli/progress.go
new file mode 100644
index 0000000..3caad2c
--- /dev/null
+++ b/runtime/cli/progress.go
@@ -0,0 +1,177 @@
+package cli
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+)
+
+// RunnerOptions are local execution hooks, not model parameters. OnEvent is
+// synchronous for backpressure. Its error cancels the child process.
+type RunnerOptions struct{ OnEvent func(CLIEvent) error }
+
+// CLIEvent contains only public answer/progress fields. Thinking and reasoning
+// events are never forwarded. Usage is a provider snapshot, not a token delta.
+type CLIEvent struct {
+	CLIType   string         `json:"cliType"`
+	Type      string         `json:"type"`
+	Text      string         `json:"text,omitempty"`
+	Status    string         `json:"status,omitempty"`
+	Model     string         `json:"model,omitempty"`
+	SessionID string         `json:"sessionId,omitempty"`
+	Usage     map[string]any `json:"usage,omitempty"`
+}
+
+type progressWriter struct {
+	cliType  string
+	callback func(CLIEvent) error
+	cancel   context.CancelFunc
+	pending  []byte
+	err      error
+	sawDelta bool
+	document bool
+}
+
+func (w *progressWriter) Write(p []byte) (int, error) {
+	if w.err != nil {
+		return 0, w.err
+	}
+	w.pending = append(w.pending, p...)
+	if len(w.pending) > 10*1024*1024 {
+		w.fail(fmt.Errorf("CLI progress line exceeds 10 MiB"))
+		return 0, w.err
+	}
+	if w.document {
+		return len(p), nil
+	}
+	for {
+		index := bytes.IndexByte(w.pending, '\n')
+		if index < 0 {
+			break
+		}
+		line := append([]byte(nil), w.pending[:index]...)
+		w.pending = w.pending[index+1:]
+		if err := w.consume(line); err != nil {
+			w.fail(err)
+			return len(p), err
+		}
+	}
+	return len(p), nil
+}
+func (w *progressWriter) fail(err error) { w.err = err; w.cancel() }
+func (w *progressWriter) flush() error {
+	if w.err != nil {
+		return w.err
+	}
+	if len(bytes.TrimSpace(w.pending)) > 0 {
+		if err := w.consume(w.pending); err != nil {
+			return err
+		}
+	}
+	w.pending = nil
+	return nil
+}
+func (w *progressWriter) consume(line []byte) error {
+	if len(bytes.TrimSpace(line)) == 0 {
+		return nil
+	}
+	var raw map[string]any
+	if err := json.Unmarshal(line, &raw); err != nil {
+		return fmt.Errorf("%s progress JSONL: %w", w.cliType, err)
+	}
+	str := func(value any) string { result, _ := value.(string); return result }
+	object := func(value any) map[string]any { result, _ := value.(map[string]any); return result }
+	e := CLIEvent{CLIType: w.cliType}
+	switch w.cliType {
+	case "codex":
+		switch str(raw["type"]) {
+		case "item.completed":
+			item := object(raw["item"])
+			if str(item["type"]) == "agent_message" {
+				e.Type = "message"
+				e.Text = str(item["text"])
+			}
+		case "turn.completed":
+			e.Type = "terminal"
+			e.Status = "completed"
+			e.Usage = object(raw["usage"])
+		case "turn.failed", "error":
+			e.Type = "terminal"
+			e.Status = "failed"
+		}
+	case "claude":
+		switch str(raw["type"]) {
+		case "system":
+			if str(raw["subtype"]) == "init" {
+				e.Type = "started"
+				e.Model = str(raw["model"])
+				e.SessionID = str(raw["session_id"])
+			}
+		case "stream_event":
+			event := object(raw["event"])
+			delta := object(event["delta"])
+			if str(delta["type"]) == "text_delta" {
+				e.Type = "text_delta"
+				e.Text = str(delta["text"])
+				w.sawDelta = true
+			}
+		case "result":
+			e.Type = "terminal"
+			e.Status = str(raw["subtype"])
+			e.Usage = object(raw["usage"])
+			e.SessionID = str(raw["session_id"])
+			if !w.sawDelta {
+				e.Text = str(raw["result"])
+			}
+		}
+	case "grok":
+		switch str(raw["type"]) {
+		case "text":
+			e.Type = "text_delta"
+			e.Text = str(raw["data"])
+		case "usage":
+			e.Type = "usage"
+			e.Usage = object(raw["usage"])
+			if e.Usage == nil {
+				e.Usage = object(raw["data"])
+			}
+		case "end":
+			e.Type = "terminal"
+			e.Status = str(raw["stopReason"])
+		case "error":
+			e.Type = "terminal"
+			e.Status = "failed"
+		default:
+			if raw["stopReason"] != nil {
+				e.Type = "terminal"
+				e.Status = str(raw["stopReason"])
+				e.Text = str(raw["text"])
+				e.Usage = object(raw["usage"])
+			}
+		}
+	case "antigravity":
+		switch str(raw["event"]) {
+		case "init":
+			init := object(raw["init"])
+			e.Type = "started"
+			e.Model = str(init["model"])
+		case "step_update":
+			step := object(raw["step_update"])
+			if str(step["step_type"]) == "agent_response" && str(step["text_delta"]) != "" {
+				e.Type = "text_delta"
+				e.Text = str(step["text_delta"])
+			}
+		case "result":
+			result := object(raw["result"])
+			e.Type = "terminal"
+			e.Status = str(result["status"])
+			e.Usage = object(result["usage"])
+			e.SessionID = str(result["conversation_id"])
+		}
+	}
+	if e.Type != "" {
+		return w.callback(e)
+	}
+	return nil
+}
diff --git a/runtime/cli/progress_test.go b/runtime/cli/progress_test.go
new file mode 100644
index 0000000..d120645
--- /dev/null
+++ b/runtime/cli/progress_test.go
@@ -0,0 +1,234 @@
+package cli
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"runtime"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+	"unicode/utf8"
+)
+
+func readProgressFixture(t *testing.T, provider, name string) string {
+	t.Helper()
+	body, err := os.ReadFile(filepath.Join("testdata", provider, name))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(body)
+}
+
+func collectProgress(t *testing.T, provider, raw string, document bool, chunkSize int) []CLIEvent {
+	t.Helper()
+	var events []CLIEvent
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	writer := &progressWriter{
+		cliType: provider, document: document, cancel: cancel,
+		callback: func(event CLIEvent) error { events = append(events, event); return nil },
+	}
+	bytes := []byte(raw)
+	for len(bytes) > 0 {
+		n := min(len(bytes), chunkSize)
+		if _, err := writer.Write(bytes[:n]); err != nil {
+			t.Fatal(err)
+		}
+		bytes = bytes[n:]
+	}
+	if err := writer.flush(); err != nil {
+		t.Fatal(err)
+	}
+	if ctx.Err() != nil {
+		t.Fatalf("valid fixture unexpectedly cancelled the child context: %v", ctx.Err())
+	}
+	return events
+}
+
+func TestProgressRealGrokStreamPreservesUTF8AndUsageSnapshots(t *testing.T) {
+	raw := readProgressFixture(t, "grok", "stream-success.jsonl")
+	var expectedText strings.Builder
+	var expectedUsage []map[string]any
+	for _, line := range strings.Split(strings.TrimSpace(raw), "\n") {
+		var event struct {
+			Type  string         `json:"type"`
+			Data  string         `json:"data"`
+			Usage map[string]any `json:"usage"`
+		}
+		if err := json.Unmarshal([]byte(line), &event); err != nil {
+			t.Fatal(err)
+		}
+		if event.Type == "text" {
+			expectedText.WriteString(event.Data)
+		}
+		if event.Type == "usage" {
+			expectedUsage = append(expectedUsage, event.Usage)
+		}
+	}
+	// One byte per Write deliberately splits the fixture's Chinese UTF-8 code
+	// points and JSON escapes across arbitrary process-pipe boundaries.
+	events := collectProgress(t, "grok", raw, false, 1)
+	var actualText strings.Builder
+	var actualUsage []map[string]any
+	terminalCount := 0
+	for _, event := range events {
+		if !utf8.ValidString(event.Text) {
+			t.Fatalf("public progress corrupted UTF-8: %q", event.Text)
+		}
+		switch event.Type {
+		case "text_delta":
+			actualText.WriteString(event.Text)
+		case "usage":
+			actualUsage = append(actualUsage, event.Usage)
+		case "terminal":
+			terminalCount++
+			if event.Status != "end_turn" {
+				t.Fatalf("wrong native terminal status: %+v", event)
+			}
+		}
+	}
+	if actualText.String() != expectedText.String() {
+		t.Fatal("public deltas did not reconstruct the real answer exactly")
+	}
+	if len(expectedUsage) == 0 || !reflect.DeepEqual(actualUsage, expectedUsage) {
+		t.Fatalf("usage must preserve provider snapshots without accumulation: actual=%v expected=%v", actualUsage, expectedUsage)
+	}
+	if terminalCount != 1 {
+		t.Fatalf("expected one public terminal, got %d", terminalCount)
+	}
+}
+
+func TestProgressRealGrokPrettyDocumentBuffersUntilFlush(t *testing.T) {
+	raw := readProgressFixture(t, "grok", "schema-success.json")
+	var envelope map[string]any
+	if err := json.Unmarshal([]byte(raw), &envelope); err != nil {
+		t.Fatal(err)
+	}
+	// Sanitized fixtures omit private reasoning. This protocol-shaped marker
+	// verifies that an upstream thought field cannot enter the public event.
+	envelope["thought"] = "PRIVATE_REASONING_MUST_NOT_LEAK"
+	body, err := json.MarshalIndent(envelope, "", "  ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var events []CLIEvent
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	writer := &progressWriter{cliType: "grok", document: true, cancel: cancel, callback: func(event CLIEvent) error { events = append(events, event); return nil }}
+	for _, b := range body {
+		if _, err := writer.Write([]byte{b}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if len(events) != 0 || ctx.Err() != nil {
+		t.Fatal("pretty native JSON must remain buffered until document completion")
+	}
+	if err := writer.flush(); err != nil {
+		t.Fatal(err)
+	}
+	if len(events) != 1 || events[0].Type != "terminal" || events[0].Status != "end_turn" {
+		t.Fatalf("expected one native document terminal: %+v", events)
+	}
+	if events[0].Text != envelope["text"] || !reflect.DeepEqual(events[0].Usage, envelope["usage"]) {
+		t.Fatal("native document answer or usage snapshot was lost")
+	}
+	serialized, err := json.Marshal(events)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(serialized), "PRIVATE_REASONING_MUST_NOT_LEAK") {
+		t.Fatal("private document thought leaked through public progress")
+	}
+}
+
+func TestProgressFiltersReasoningAndPreservesRepeatedDeltas(t *testing.T) {
+	const private = "PRIVATE_REASONING_MUST_NOT_LEAK"
+	for _, test := range []struct{ provider, raw string }{
+		{"grok", "{\"type\":\"thought\",\"data\":\"" + private + "\"}\n{\"type\":\"text\",\"data\":\"好\"}\n{\"type\":\"text\",\"data\":\"好\"}\n"},
+		{"claude", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"thinking_delta\",\"thinking\":\"" + private + "\"}}}\n{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"好\"}}}\n{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"好\"}}}\n"},
+		{"codex", "{\"type\":\"item.completed\",\"item\":{\"type\":\"reasoning\",\"text\":\"" + private + "\"}}\n{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\",\"text\":\"好\"}}\n{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\",\"text\":\"好\"}}\n"},
+		{"antigravity", "{\"event\":\"step_update\",\"step_update\":{\"step_type\":\"agent_thought\",\"text_delta\":\"" + private + "\"}}\n{\"event\":\"step_update\",\"step_update\":{\"step_type\":\"agent_response\",\"text_delta\":\"好\"}}\n{\"event\":\"step_update\",\"step_update\":{\"step_type\":\"agent_response\",\"text_delta\":\"好\"}}\n"},
+	} {
+		t.Run(test.provider, func(t *testing.T) {
+			events := collectProgress(t, test.provider, test.raw, false, 2)
+			var text strings.Builder
+			for _, event := range events {
+				text.WriteString(event.Text)
+			}
+			if text.String() != "好好" || len(events) != 2 {
+				t.Fatalf("reasoning must be filtered and repeated public text preserved: %+v", events)
+			}
+		})
+	}
+}
+
+func TestProgressRealAgyUsageIsTerminalSnapshot(t *testing.T) {
+	raw := readProgressFixture(t, "agy", "stream-schema-success.jsonl")
+	events := collectProgress(t, "antigravity", raw, false, 7)
+	var terminal *CLIEvent
+	for i := range events {
+		if events[i].Type == "terminal" {
+			terminal = &events[i]
+		}
+	}
+	if terminal == nil || terminal.Status != "SUCCESS" || terminal.Usage["total_tokens"] != float64(24961) {
+		t.Fatalf("agy terminal must keep the real usage snapshot once, not add step usage: %+v", terminal)
+	}
+}
+
+func TestRunCommandProgressCancellationPreservesTruncatedOutput(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("POSIX subprocess signal integration")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	ready := make(chan struct{})
+	var once sync.Once
+	go func() {
+		select {
+		case <-ready:
+			timer := time.NewTimer(50 * time.Millisecond)
+			defer timer.Stop()
+			select {
+			case <-timer.C:
+				cancel()
+			case <-ctx.Done():
+			}
+		case <-ctx.Done():
+		}
+	}()
+	started := time.Now()
+	_, err := runCommandWithOptions(ctx, "grok", "sh", []string{"-c", `printf '%s\n%s' '{"type":"text","data":"public"}' '{"type":"text","data":"truncated'; printf 'preserved diagnostic' >&2; sleep 30`, "fixture-cli", "--output-format", "streaming-json"}, nil, "", "", RunnerOptions{OnEvent: func(CLIEvent) error { once.Do(func() { close(ready) }); return nil }})
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("truncated final event must not hide cancellation: %T %v", err, err)
+	}
+	var commandErr *CommandError
+	if !errors.As(err, &commandErr) || !strings.Contains(commandErr.Stdout, `{"type":"text","data":"truncated`) || commandErr.Stderr != "preserved diagnostic" {
+		t.Fatalf("cancellation must retain partial stdout and stderr: %+v", commandErr)
+	}
+	if elapsed := time.Since(started); elapsed > 4*time.Second {
+		t.Fatalf("cancellation did not stop the subprocess within its bounded grace: %s", elapsed)
+	}
+}
+
+func TestRunCommandProgressCallbackFailureCancelsSubprocess(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("POSIX subprocess signal integration")
+	}
+	callbackErr := errors.New("consumer closed progress stream")
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	started := time.Now()
+	_, err := runCommandWithOptions(ctx, "grok", "sh", []string{"-c", `printf '%s\n' '{"type":"text","data":"public"}'; sleep 30`, "fixture-cli", "--output-format", "streaming-json"}, nil, "", "", RunnerOptions{OnEvent: func(CLIEvent) error { return callbackErr }})
+	if !errors.Is(err, callbackErr) {
+		t.Fatalf("callback failure must remain inspectable: %T %v", err, err)
+	}
+	if elapsed := time.Since(started); elapsed > 4*time.Second {
+		t.Fatalf("callback failure left the subprocess running too long: %s", elapsed)
+	}
+}
diff --git a/runtime/cli/stream_schema.go b/runtime/cli/stream_schema.go
new file mode 100644
index 0000000..22bab79
--- /dev/null
+++ b/runtime/cli/stream_schema.go
@@ -0,0 +1,118 @@
+package cli
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	"github.com/santhosh-tekuri/jsonschema/v6"
+	"github.com/suchasplus/til-consensus/config"
+)
+
+func streamingSchemaPrompt(provider config.ProviderConfig, prompt string, schema map[string]any) (string, error) {
+	if provider.CLIType != config.CLITypeGrok || provider.OutputFormat != "stream-json" || len(schema) == 0 {
+		return prompt, nil
+	}
+	body, err := json.Marshal(schema)
+	if err != nil {
+		return "", err
+	}
+	return prompt + "\nJSON Schema for the final answer:\n" + string(body), nil
+}
+
+func validateStreamingSchema(schema map[string]any, output string) error {
+	// 调用方可使用 []string、[]map[string]any 等 Go 容器构建 schema；
+	// 编译器要求解码后的 JSON 类型。经过序列化边界也避免修改调用方的对象。
+	body, err := json.Marshal(schema)
+	if err != nil {
+		return fmt.Errorf("CLI output schema: encode JSON: %w", err)
+	}
+	normalized, err := jsonschema.UnmarshalJSON(bytes.NewReader(body))
+	if err != nil {
+		return fmt.Errorf("CLI output schema: decode JSON: %w", err)
+	}
+	if _, ok := normalized.(map[string]any); !ok {
+		return fmt.Errorf("CLI output schema: expected a JSON object")
+	}
+	compiler := jsonschema.NewCompiler()
+	const location = "urn:til-consensus:cli-output"
+	if err := compiler.AddResource(location, normalized); err != nil {
+		return fmt.Errorf("CLI output schema: %w", err)
+	}
+	compiled, err := compiler.Compile(location)
+	if err != nil {
+		return fmt.Errorf("CLI output schema: %w", err)
+	}
+	value, err := jsonschema.UnmarshalJSON(strings.NewReader(output))
+	if err != nil {
+		return fmt.Errorf("CLI structured stream must return JSON: %w", err)
+	}
+	if err := compiled.Validate(value); err != nil {
+		return fmt.Errorf("CLI structured stream violates output schema: %w", err)
+	}
+	return nil
+}
+
+func hasOutputFormat(args []string, format string) bool {
+	for i, arg := range args {
+		if arg == "--output-format" && i+1 < len(args) && args[i+1] == format {
+			return true
+		}
+		if arg == "--output-format="+format {
+			return true
+		}
+	}
+	return false
+}
+
+func validateOneShotArgs(provider config.ProviderConfig) error {
+	switch provider.CLIType {
+	case config.CLITypeCodex, config.CLITypeClaude, config.CLITypeGrok, config.CLITypeAntigravity:
+	default:
+		return nil
+	}
+	for index, arg := range provider.Args {
+		name, _, _ := strings.Cut(arg, "=")
+		for _, blocked := range []string{"--continue", "--resume", "--conversation", "--input-format", "--output-format", "--json-schema", "--output-schema", "--output-last-message", "-o", "--prompt-file"} {
+			if name == blocked {
+				return fmt.Errorf("%s one-shot transport manages %s; use the provider execution fields and a fresh task process", provider.CLIType, blocked)
+			}
+		}
+		if (provider.CLIType == config.CLITypeAntigravity || provider.CLIType == config.CLITypeGrok) && (name == "-c" || name == "-p" || name == "--prompt" || name == "--print") {
+			return fmt.Errorf("%s transport does not allow overriding %s", provider.CLIType, name)
+		}
+		if provider.Workdir != "" && (name == "--cwd" || name == "--cd" || name == "-C" || name == "--project") {
+			return fmt.Errorf("provider workdir cannot be overridden by %s", name)
+		}
+		if provider.PermissionMode == "read-only" {
+			if provider.CLIType == config.CLITypeCodex && strings.HasPrefix(arg, "-c") && !strings.HasPrefix(arg, "--") && len(arg) > 2 {
+				key, _, _ := strings.Cut(arg[2:], "=")
+				if strings.HasPrefix(key, "sandbox") || key == "approval_policy" {
+					return fmt.Errorf("read-only profile cannot override config %s", key)
+				}
+			}
+			if strings.HasPrefix(name, "--dangerously-") {
+				return fmt.Errorf("read-only profile cannot use %s", name)
+			}
+			for _, blocked := range []string{"--sandbox", "--permission-mode", "--mode", "--tools", "--allowedTools", "--allowed-tools", "--allow", "--always-approve", "--no-plan", "--yolo", "--full-auto", "--disable-slash-commands"} {
+				if name == blocked {
+					return fmt.Errorf("read-only profile cannot be overridden by %s", name)
+				}
+			}
+			if provider.CLIType == config.CLITypeCodex && (name == "-c" || name == "--config") {
+				value := ""
+				if _, after, ok := strings.Cut(arg, "="); ok {
+					value = after
+				} else if index+1 < len(provider.Args) {
+					value = provider.Args[index+1]
+				}
+				key, _, _ := strings.Cut(value, "=")
+				if strings.HasPrefix(key, "sandbox") || key == "approval_policy" {
+					return fmt.Errorf("read-only profile cannot override config %s", key)
+				}
+			}
+		}
+	}
+	return nil
+}
diff --git a/runtime/cli/stream_schema_test.go b/runtime/cli/stream_schema_test.go
new file mode 100644
index 0000000..5fe8e60
--- /dev/null
+++ b/runtime/cli/stream_schema_test.go
@@ -0,0 +1,156 @@
+package cli
+
+import (
+	"context"
+	"encoding/json"
+	"math"
+	"strings"
+	"testing"
+
+	"github.com/suchasplus/til-consensus/config"
+)
+
+func TestStreamingSchemaIsEnforced(t *testing.T) {
+	schema := map[string]any{"type": "object", "additionalProperties": false, "required": []any{"answer"}, "properties": map[string]any{"answer": map[string]any{"type": "integer"}}}
+	for _, invalid := range []string{`done`, `{}`, `{"answer":"7"}`, `{"answer":7,"extra":true}`} {
+		if err := validateStreamingSchema(schema, invalid); err == nil {
+			t.Fatalf("invalid output passed schema: %s", invalid)
+		}
+	}
+	if err := validateStreamingSchema(schema, `{"answer":7}`); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestStreamingSchemaNormalizesNestedGoContainersWithoutWeakeningValidation(t *testing.T) {
+	// 对应桌面评审的两种互斥引用：已有 claim，或本次 invocation 的草稿。
+	// enum/required 使用 []string，组合关键字还包含 []map[string]any。
+	schema := map[string]any{
+		"type": "object", "additionalProperties": false,
+		"required": []string{"desktopReview"},
+		"properties": map[string]any{
+			"desktopReview": map[string]any{
+				"type": "array", "minItems": 1,
+				"items": map[string]any{
+					"type": "object", "additionalProperties": false,
+					"required": []string{"severity", "status"},
+					"properties": map[string]any{
+						"severity":        map[string]any{"type": "string", "enum": []string{"blocking", "major", "minor"}},
+						"status":          map[string]any{"type": "string", "enum": []string{"open", "resolved"}},
+						"claimId":         map[string]any{"type": "string", "minLength": 1},
+						"invocationId":    map[string]any{"type": "string", "minLength": 1},
+						"claimDraftIndex": map[string]any{"type": "integer", "minimum": 0},
+						"draftStatement":  map[string]any{"type": "string", "minLength": 1},
+					},
+					"oneOf": []map[string]any{
+						{
+							"required": []string{"claimId"},
+							"not": map[string]any{"anyOf": []map[string]any{
+								{"required": []string{"invocationId"}},
+								{"required": []string{"claimDraftIndex"}},
+								{"required": []string{"draftStatement"}},
+							}},
+						},
+						{
+							"required": []string{"invocationId", "claimDraftIndex", "draftStatement"},
+							"not":      map[string]any{"required": []string{"claimId"}},
+						},
+					},
+				},
+			},
+		},
+	}
+	before, err := json.Marshal(schema)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, valid := range []string{
+		`{"desktopReview":[{"severity":"blocking","status":"open","claimId":"claim-1"}]}`,
+		`{"desktopReview":[{"severity":"minor","status":"resolved","invocationId":"inv-1","claimDraftIndex":0,"draftStatement":"需要补充证据"}]}`,
+	} {
+		if err := validateStreamingSchema(schema, valid); err != nil {
+			t.Fatalf("valid review rejected after JSON normalization: %v", err)
+		}
+	}
+	for _, invalid := range []string{
+		`{}`,
+		`{"desktopReview":[{"severity":"critical","status":"open","claimId":"claim-1"}]}`,
+		`{"desktopReview":[{"severity":"major","claimId":"claim-1"}]}`,
+		`{"desktopReview":[{"severity":"major","status":"open"}]}`,
+		`{"desktopReview":[{"severity":"major","status":"open","claimId":"claim-1","invocationId":"inv-1","claimDraftIndex":0,"draftStatement":"冲突引用"}]}`,
+		`{"desktopReview":[{"severity":"major","status":"open","invocationId":"inv-1","claimDraftIndex":0}]}`,
+		`{"desktopReview":[{"severity":"major","status":"open","invocationId":"inv-1","claimDraftIndex":"0","draftStatement":"错误类型"}]}`,
+	} {
+		if err := validateStreamingSchema(schema, invalid); err == nil || !strings.Contains(err.Error(), "violates output schema") {
+			t.Fatalf("review constraints were weakened: output=%s err=%v", invalid, err)
+		}
+	}
+	after, err := json.Marshal(schema)
+	if err != nil || string(after) != string(before) {
+		t.Fatalf("normalization modified caller schema: err=%v", err)
+	}
+	if _, ok := schema["required"].([]string); !ok {
+		t.Fatal("normalization replaced the caller's typed slice")
+	}
+}
+
+func TestStreamingSchemaPreservesIntegerPrecision(t *testing.T) {
+	schema := map[string]any{"type": "integer", "const": uint64(9007199254740993)}
+	if err := validateStreamingSchema(schema, `9007199254740993`); err != nil {
+		t.Fatalf("exact integer rejected: %v", err)
+	}
+	if err := validateStreamingSchema(schema, `9007199254740992`); err == nil {
+		t.Fatal("neighboring integer passed after losing JSON number precision")
+	}
+}
+
+func TestStreamingSchemaInvalidInputsReturnErrors(t *testing.T) {
+	cycle := map[string]any{}
+	cycle["properties"] = cycle
+	for _, test := range []struct {
+		name   string
+		schema map[string]any
+		output string
+		want   string
+	}{
+		{"nil schema", nil, `{}`, "expected a JSON object"},
+		{"unsupported Go value", map[string]any{"enum": []any{make(chan int)}}, `{}`, "encode JSON"},
+		{"cyclic Go map", cycle, `{}`, "encode JSON"},
+		{"nonfinite number", map[string]any{"minimum": math.NaN()}, `1`, "encode JSON"},
+		{"malformed schema", map[string]any{"type": "unknown-type"}, `{}`, "CLI output schema"},
+		{"invalid JSON", map[string]any{"type": "object"}, `done`, "must return JSON"},
+		{"multiple JSON documents", map[string]any{"type": "object"}, `{} {}`, "must return JSON"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			// 输入错误必须返回 error；任何 panic 都会使本项回归失败。
+			err := validateStreamingSchema(test.schema, test.output)
+			if err == nil || !strings.Contains(err.Error(), test.want) {
+				t.Fatalf("got %v, want error containing %q", err, test.want)
+			}
+		})
+	}
+}
+
+func TestGrokStreamingSchemaPromptLimitFailsBeforeExecution(t *testing.T) {
+	runner := NewRunner(config.ProviderConfig{CLIType: config.CLITypeGrok, Command: "must-not-execute", OutputFormat: "stream-json"})
+	_, err := runner.RunTaskDetailed(context.Background(), realPromptTransportTestTask{}, strings.Repeat("x", maxCLIPromptBytes-20), "agent", "reviewer", "", "", nil, map[string]any{"type": "object"})
+	if err == nil || !strings.Contains(err.Error(), "safety limit") {
+		t.Fatalf("expected bounded validation error, got %v", err)
+	}
+}
+
+func TestManagedTransportAndReadOnlyCannotBeOverridden(t *testing.T) {
+	for _, provider := range []config.ProviderConfig{
+		{CLIType: config.CLITypeAntigravity, Args: []string{"--conversation=old"}},
+		{CLIType: config.CLITypeAntigravity, Args: []string{"-c"}},
+		{CLIType: config.CLITypeGrok, Args: []string{"--output-format=plain"}},
+		{CLIType: config.CLITypeClaude, PermissionMode: "read-only", Args: []string{"--dangerously-skip-permissions"}},
+		{CLIType: config.CLITypeCodex, PermissionMode: "read-only", Args: []string{"-c", "sandbox_mode=\"danger-full-access\""}},
+		{CLIType: config.CLITypeCodex, PermissionMode: "read-only", Args: []string{"-csandbox_mode=\"danger-full-access\""}},
+		{CLIType: config.CLITypeCodex, Workdir: "/private/run", Args: []string{"--cd", "/other"}},
+	} {
+		if err := validateOneShotArgs(provider); err == nil {
+			t.Fatalf("managed execution silently overridden: %+v", provider)
+		}
+	}
+}
