{
  "name": "tcview",
  "productName": "TCView",
  "version": "0.6.0",
  "private": true,
  "description": "由确定性程序主持的桌面多模型共识讨论室",
  "type": "module",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build-host.mjs",
    "check": "tsc --noEmit",
    "test:build-env": "node --test tests/go-env.test.mjs",
    "verify:dependency": "node scripts/verify-engine-dependency.mjs",
    "verify:preparation:live": "node scripts/live-preparation-smoke.mjs",
    "verify:cli-settings:live": "node scripts/live-cli-settings-smoke.mjs",
    "test:host": "node scripts/test-host.mjs",
    "test:rpc": "node --test tests/rpc.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:build-env && npm run test:host && npm run check && npm run build && npm run test:rpc && npm run test:e2e",
    "package:mac": "node scripts/package-mac.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:providers:batch:live": "node scripts/live-provider-batch-smoke.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
